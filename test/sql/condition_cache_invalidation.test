# name: test/sql/condition_cache_invalidation.test
# description: Any DML drops every cache entry for the table it touched
# group: [sql]

require query_condition_cache

# Build entries explicitly so the assertions are about invalidation, not auto-build.
statement ok
SET use_query_condition_cache = false;

statement ok
CREATE TABLE t AS SELECT i AS id, i % 100 AS val FROM range(130000) t(i);

statement ok
SELECT * FROM condition_cache_build('t', 'val = 42 AND id % 2 = 0');

query I
SELECT cached_row_groups FROM condition_cache_info('t', 'val = 42 AND id % 2 = 0');
----
2

# DELETE drops the whole entry, not just the row groups it touched.
statement ok
DELETE FROM t WHERE id < 1000;

query I
SELECT cached_row_groups FROM condition_cache_info('t', 'val = 42 AND id % 2 = 0');
----
0

# Results stay correct after the drop, with the cache back on.
statement ok
SET use_query_condition_cache = true;

query I
SELECT count(*) FROM t WHERE val = 42 AND id % 2 = 0;
----
1290

statement ok
SET use_query_condition_cache = false;

query I
SELECT count(*) FROM t WHERE val = 42 AND id % 2 = 0;
----
1290

# UPDATE drops it too.
statement ok
SELECT * FROM condition_cache_build('t', 'val = 42 AND id % 2 = 0');

statement ok
UPDATE t SET val = val + 1 WHERE id = 125000;

query I
SELECT cached_row_groups FROM condition_cache_info('t', 'val = 42 AND id % 2 = 0');
----
0

# INSERT drops it too. This is the case the old per-row-group path could not resolve, because
# the invalidator's OperatorFinalize runs before the insert sink merges the new rows.
statement ok
SELECT * FROM condition_cache_build('t', 'val = 42 AND id % 2 = 0');

statement ok
INSERT INTO t SELECT 200000 + i, 42 FROM range(10) t(i);

query I
SELECT cached_row_groups FROM condition_cache_info('t', 'val = 42 AND id % 2 = 0');
----
0

# The new rows must be visible through the cache.
statement ok
SET use_query_condition_cache = true;

query I
SELECT count(*) FROM t WHERE val = 42 AND id % 2 = 0;
----
1295

statement ok
SET use_query_condition_cache = false;

query I
SELECT count(*) FROM t WHERE val = 42 AND id % 2 = 0;
----
1295

# Coarse, but still per table: DML on another table leaves this one's entries alone.
statement ok
CREATE TABLE other AS SELECT i AS id FROM range(10) t(i);

statement ok
SELECT * FROM condition_cache_build('t', 'val = 42 AND id % 2 = 0');

statement ok
DELETE FROM other WHERE id = 1;

query I
SELECT cached_row_groups > 0 FROM condition_cache_info('t', 'val = 42 AND id % 2 = 0');
----
true

# A prepared statement is planned once and executed from the cached plan, so an optimizer-time
# hook would never see the EXECUTE. The invalidator lives in the plan, so it runs either way.
statement ok
CREATE TABLE prep AS SELECT i AS id, 7 AS val FROM range(130000) t(i);

statement ok
PREPARE ins AS INSERT INTO prep SELECT 900000 + i, 42 FROM range(5) t(i);

statement ok
SELECT * FROM condition_cache_build('prep', 'val = 42');

statement ok
EXECUTE ins;

statement ok
SET use_query_condition_cache = true;

query I
SELECT count(*) FROM prep WHERE val = 42;
----
5

statement ok
SET use_query_condition_cache = false;

query I
SELECT count(*) FROM prep WHERE val = 42;
----
5

# EXPLAIN builds a DML plan without running it, so the entries must survive.
statement ok
SELECT * FROM condition_cache_build('prep', 'val = 42');

statement ok
EXPLAIN DELETE FROM prep WHERE id < 10;

query I
SELECT cached_row_groups > 0 FROM condition_cache_info('prep', 'val = 42');
----
true

# A statement that fails never reaches execution, so it must not drop anything.
# Rebuild first: toggling use_query_condition_cache above cleared the whole store.
statement ok
SELECT * FROM condition_cache_build('t', 'val = 42 AND id % 2 = 0');

statement error
INSERT INTO t VALUES (1, 'not an integer at all');
----

query I
SELECT cached_row_groups > 0 FROM condition_cache_info('t', 'val = 42 AND id % 2 = 0');
----
true
